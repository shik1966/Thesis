\@writefile{lof}{\contentsline {figure}{\numberline {3.71}{\ignorespaces \textbf  {Combined Features Sample 9.} Clear distinction between pathological and normal tissues due to multi-filter preprocessing.}}{128}{figure.caption.70}\protected@file@percent }
\newlabel{fig:combined_sub9}{{3.71}{128}{\textbf {Combined Features Sample 9.} Clear distinction between pathological and normal tissues due to multi-filter preprocessing}{figure.caption.70}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.72}{\ignorespaces \textbf  {Combined Features Sample 10.} Strong visual correlation between preprocessed features and segmentation mask, even for challenging scenarios.}}{129}{figure.caption.71}\protected@file@percent }
\newlabel{fig:combined_sub10}{{3.72}{129}{\textbf {Combined Features Sample 10.} Strong visual correlation between preprocessed features and segmentation mask, even for challenging scenarios}{figure.caption.71}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6.3}Combined Training History: Accuracy, Loss, and Dice Coefficient}{130}{subsection.3.6.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.73}{\ignorespaces \textbf  {Combined Multiclass Dice Coefficient vs. Epoch.} The multiclass Dice coefficient curves illustrate steady improvement over epochs, with a notable spike in the final epoch. Initially, the model started from a low Dice value (around 0.24), progressively improving, and ultimately achieving a substantial increase to approximately 0.77 (training) and 0.72 (validation). This demonstrates that the expanded subsampling and combined preprocessing significantly enhance the model’s segmentation capability. The fluctuations observed are typical for challenging segmentation tasks, especially considering the complexity and variability of the dataset.}}{131}{figure.caption.72}\protected@file@percent }
\newlabel{fig:combined_dice}{{3.73}{131}{\textbf {Combined Multiclass Dice Coefficient vs. Epoch.} The multiclass Dice coefficient curves illustrate steady improvement over epochs, with a notable spike in the final epoch. Initially, the model started from a low Dice value (around 0.24), progressively improving, and ultimately achieving a substantial increase to approximately 0.77 (training) and 0.72 (validation). This demonstrates that the expanded subsampling and combined preprocessing significantly enhance the model’s segmentation capability. The fluctuations observed are typical for challenging segmentation tasks, especially considering the complexity and variability of the dataset}{figure.caption.72}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.74}{\ignorespaces \textbf  {Combined Multiclass Accuracy and Loss vs. Epoch.} \emph  {Left:} Accuracy rapidly improved during initial epochs, stabilizing close to 99\% on both training and validation datasets, indicating effective learning and robust generalization despite minor fluctuations due to data complexity. \emph  {Right:} The loss curve sharply decreased over the initial epochs before settling at lower values, clearly showing that the model effectively converged. Validation loss initially fluctuated more significantly but ultimately converged to a stable, low value, aligning closely with training loss.}}{132}{figure.caption.73}\protected@file@percent }
\newlabel{fig:combined_acc_loss}{{3.74}{132}{\textbf {Combined Multiclass Accuracy and Loss vs. Epoch.} \emph {Left:} Accuracy rapidly improved during initial epochs, stabilizing close to 99\% on both training and validation datasets, indicating effective learning and robust generalization despite minor fluctuations due to data complexity. \emph {Right:} The loss curve sharply decreased over the initial epochs before settling at lower values, clearly showing that the model effectively converged. Validation loss initially fluctuated more significantly but ultimately converged to a stable, low value, aligning closely with training loss}{figure.caption.73}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6.4}Combined Feature Detectors Test‐Set Metrics (Full vs. Simple Policy)}{133}{subsection.3.6.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.75}{\ignorespaces \textbf  {Combined Test-Set Metrics per Tumor Class (Full vs. Simple Policy).}}}{134}{figure.caption.74}\protected@file@percent }
\newlabel{fig:combined_testset_metrics}{{3.75}{134}{\textbf {Combined Test-Set Metrics per Tumor Class (Full vs. Simple Policy).}}{figure.caption.74}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6.5}Combined Pipeline Per-Class Pixel Metrics}{136}{subsection.3.6.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.76}{\ignorespaces \textbf  {Combined Pipeline Per-Class Pixel Metrics.} Pixel-level segmentation performance across the three tumor sub-classes. Rows illustrate metrics including True Positives (TP), False Positives (FP), False Negatives (FN), True Negatives (TN), Precision, Recall, Specificity, and average FP/FN per slice. High precision and recall values indicate strong segmentation accuracy, while high specificity and low FP/FN per slice indicate robust and reliable segmentation boundaries.}}{137}{figure.caption.75}\protected@file@percent }
\newlabel{fig:combined_pixel_metrics}{{3.76}{137}{\textbf {Combined Pipeline Per-Class Pixel Metrics.} Pixel-level segmentation performance across the three tumor sub-classes. Rows illustrate metrics including True Positives (TP), False Positives (FP), False Negatives (FN), True Negatives (TN), Precision, Recall, Specificity, and average FP/FN per slice. High precision and recall values indicate strong segmentation accuracy, while high specificity and low FP/FN per slice indicate robust and reliable segmentation boundaries}{figure.caption.75}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6.6}Combined Qualitative Validation: Predicted vs. Ground Truth Masks}{139}{subsection.3.6.6}\protected@file@percent }
\newlabel{sec:combined_qualitative_validation}{{3.6.6}{139}{Combined Qualitative Validation: Predicted vs. Ground Truth Masks}{subsection.3.6.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.77}{\ignorespaces \textbf  {Raw Input, Ground Truth, and Predicted Mask – Example 1.} \newline  \textbf  {Left:} Original MRI slice (T1ce, T2, FLAIR). \textbf  {Middle:} Ground truth mask showing no tumor presence. \textbf  {Right:} Predicted mask accurately indicates no tumor, demonstrating the model's high specificity in true negative cases.}}{139}{figure.caption.76}\protected@file@percent }
\newlabel{fig:combined_pred_1}{{3.77}{139}{\textbf {Raw Input, Ground Truth, and Predicted Mask – Example 1.} \newline \textbf {Left:} Original MRI slice (T1ce, T2, FLAIR). \textbf {Middle:} Ground truth mask showing no tumor presence. \textbf {Right:} Predicted mask accurately indicates no tumor, demonstrating the model's high specificity in true negative cases}{figure.caption.76}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.78}{\ignorespaces \textbf  {Raw Input, Ground Truth, and Predicted Mask – Example 2.} \newline  This example clearly illustrates the model's effective segmentation capability for large tumor regions. The predicted mask closely matches the ground truth mask, accurately identifying tumor core (blue), edema (green), and enhancing tumor (red), with minor over-segmentation in enhancing tumor areas.}}{140}{figure.caption.77}\protected@file@percent }
\newlabel{fig:combined_pred_2}{{3.78}{140}{\textbf {Raw Input, Ground Truth, and Predicted Mask – Example 2.} \newline This example clearly illustrates the model's effective segmentation capability for large tumor regions. The predicted mask closely matches the ground truth mask, accurately identifying tumor core (blue), edema (green), and enhancing tumor (red), with minor over-segmentation in enhancing tumor areas}{figure.caption.77}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.79}{\ignorespaces \textbf  {Raw Input, Ground Truth, and Predicted Mask – Example 3.} \newline  The model successfully segments the tumor core and edema regions with high accuracy, although the boundary details of the edema region appear slightly smoother and less detailed in the prediction compared to the ground truth.}}{140}{figure.caption.78}\protected@file@percent }
\newlabel{fig:combined_pred_3}{{3.79}{140}{\textbf {Raw Input, Ground Truth, and Predicted Mask – Example 3.} \newline The model successfully segments the tumor core and edema regions with high accuracy, although the boundary details of the edema region appear slightly smoother and less detailed in the prediction compared to the ground truth}{figure.caption.78}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.80}{\ignorespaces \textbf  {Raw Input, Ground Truth, and Predicted Mask – Example 4.} \newline  This example shows accurate localization and segmentation of the tumor region, with the predicted mask closely resembling the ground truth. Minor discrepancies are observed within the enhancing tumor region, illustrating some difficulty in distinguishing fine internal structures.}}{141}{figure.caption.79}\protected@file@percent }
\newlabel{fig:combined_pred_4}{{3.80}{141}{\textbf {Raw Input, Ground Truth, and Predicted Mask – Example 4.} \newline This example shows accurate localization and segmentation of the tumor region, with the predicted mask closely resembling the ground truth. Minor discrepancies are observed within the enhancing tumor region, illustrating some difficulty in distinguishing fine internal structures}{figure.caption.79}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.81}{\ignorespaces \textbf  {Raw Input, Ground Truth, and Predicted Mask – Example 5.} \newline  Here, the predicted mask closely matches the ground truth mask, accurately capturing both the core and enhancing tumor regions. However, minor deviations are visible in boundary regions of edema, indicative of the challenges faced by the model in precisely delineating diffuse boundaries.}}{141}{figure.caption.80}\protected@file@percent }
\newlabel{fig:combined_pred_5}{{3.81}{141}{\textbf {Raw Input, Ground Truth, and Predicted Mask – Example 5.} \newline Here, the predicted mask closely matches the ground truth mask, accurately capturing both the core and enhancing tumor regions. However, minor deviations are visible in boundary regions of edema, indicative of the challenges faced by the model in precisely delineating diffuse boundaries}{figure.caption.80}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.82}{\ignorespaces \textbf  {Raw Input, Ground Truth, and Predicted Mask – Example 6.} \newline  This challenging case highlights a limitation of the model. The ground truth shows small tumor lesions, while the predicted mask incorrectly shows no tumor presence, underscoring the difficulty in accurately detecting small or subtle lesions.}}{142}{figure.caption.81}\protected@file@percent }
\newlabel{fig:combined_pred_6}{{3.82}{142}{\textbf {Raw Input, Ground Truth, and Predicted Mask – Example 6.} \newline This challenging case highlights a limitation of the model. The ground truth shows small tumor lesions, while the predicted mask incorrectly shows no tumor presence, underscoring the difficulty in accurately detecting small or subtle lesions}{figure.caption.81}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.83}{\ignorespaces \textbf  {Raw Input, Ground Truth, and Predicted Mask – Example 7.} \newline  Another true negative example, with both ground truth and predicted masks showing no tumor presence. This reinforces the model's strong specificity and capability to correctly identify healthy slices without false-positive predictions.}}{142}{figure.caption.82}\protected@file@percent }
\newlabel{fig:combined_pred_7}{{3.83}{142}{\textbf {Raw Input, Ground Truth, and Predicted Mask – Example 7.} \newline Another true negative example, with both ground truth and predicted masks showing no tumor presence. This reinforces the model's strong specificity and capability to correctly identify healthy slices without false-positive predictions}{figure.caption.82}{}}
